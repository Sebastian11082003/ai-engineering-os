        "apps/inventario-codigos/public/**"
      ],
      "docs": [
        "apps/inventario-codigos/docs/12-ux-ui/**",
        "apps/inventario-codigos/docs/07-api/**",
        "apps/inventario-codigos/docs/14-training/**"
      ]
    },
    "database": {
