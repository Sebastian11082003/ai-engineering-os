{
  "$comment": "Config del REPOSITORIO DEL OS. No copiar a un proyecto consumidor. El producto usa templates/ci/living-docs.json (superficies backend/frontend/database/devops → docs/00–15).",
  "docsRoot": "docs",
  "requireDocsRootChange": false,
  "surfaces": {
    "framework": {
      "code": [
        "core/**",
        "agents/**",
        "teams/**",
        "standards/**",
        "playbooks/**",
        "templates/**",
        "checklists/**",
        "FRAMEWORK_RULES.md",
        "MASTER.md",
        "AGENTS.md"
      ],
      "docs": [
        "CHANGELOG.md",
        "PROJECT_STATE.md"
      ]
    },
    "framework-ci": {
      "code": [
        ".github/workflows/**",
        "scripts/**",
        ".living-docs.json"
      ],
      "docs": [
        "standards/living-docs-ci.md",
        "CHANGELOG.md"
      ]
    }
  },
  "ignore": [
    "**/*.lock",
    "**/package-lock.json",
    "**/pnpm-lock.yaml",
    "**/yarn.lock",
    "**/composer.lock",
    "**/*.min.js",
    "**/*.min.css",
    "**/.DS_Store",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/*.png",
    "**/*.jpg",
    "**/*.jpeg",
    "**/*.gif",
    "**/*.webp",
    "**/*.ico"
  ]
}
